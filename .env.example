# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme   # required
POSTGRES_DB=velomate         # database name (default: velomate)
POSTGRES_USER=velomate       # database user (default: velomate)
POSTGRES_PORT=5423           # host port mapped to PostgreSQL 5432 (default: 5423)
# NOTE: POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD are applied by Postgres
# only when it first initialises an empty data volume. Changing them on an
# existing deployment needs a fresh volume (`docker compose down -v`) or a manual
# `ALTER ROLE` / `CREATE DATABASE` — otherwise the ingestor and Grafana switch to
# the new values and fail to connect to the still-existing old role/database.

# ── Activity sources (at least one required) ─────────────────────────────────
# Strava — from strava.com/settings/api; get the refresh token via
# `python3 -m velomate.cli auth`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Ride with GPS (optional — either Strava or RWGPS credentials must be set).
# Create an API client at ridewithgps.com -> account settings -> developers,
# then generate an auth token on the same page.
RWGPS_API_KEY=
RWGPS_AUTH_TOKEN=

# intervals.icu — the primary activity source. Free, and can relay Garmin,
# Wahoo, Zwift, Polar, Suunto and Coros data without any Strava account.
# Get both values from intervals.icu -> Settings -> Developer Settings.
#
# NOTE: activities that reached intervals.icu *via Strava* cannot be served
# back through their API (Strava's terms forbid re-serving Strava data), so
# they are skipped and reported per batch. Upload directly to intervals.icu
# — or sync your head unit to it — for full coverage.
INTERVALS_ICU_ATHLETE_ID=
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_SYNC_WINDOW_DAYS=14   # rolling poll window; no cursor, so a
                                    # failed ride simply retries next poll
INTERVALS_ICU_SWEEP_DAYS=90         # daily reconciliation window (deletions)

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme               # required
GRAFANA_PORT=3021                       # host port for the Grafana UI (default: 3021)
# GRAFANA_ROOT_URL — public URL Grafana uses for absolute links (share URLs, OAuth
# redirects). Auto-derived from GRAFANA_PORT when unset; set it explicitly only when
# serving Grafana behind a reverse proxy or on a different external URL.
# GRAFANA_ROOT_URL=https://grafana.example.com/

# ── Ingestor ─────────────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=10     # how often to poll each activity source (default: 10)

# VELOMATE_TOKEN_FALLBACK — where a rotated Strava refresh token is written if the
# database write fails. Defaults inside the velomate-token-data volume so it survives
# a container restart. Only relevant when Strava is configured; override to relocate it.
# VELOMATE_TOKEN_FALLBACK=/app/data/.strava_refresh_token

# Fitness thresholds (optional — auto-estimated from data if not set)
VELOMATE_MAX_HR=0          # Your max heart rate (e.g. 182)
VELOMATE_FTP=0             # Your FTP in watts (e.g. 165)
VELOMATE_RESTING_HR=0      # Your resting heart rate (e.g. 48). Default: 50 bpm
VELOMATE_WEIGHT=0          # Your weight in kg (e.g. 75). Enables W/kg on Activity Details
VELOMATE_RESET_RIDE_FTP=0  # Set to 1 to reset all per-ride FTP values on next restart (one-shot)

# Backfill window — how far back to pull activities from each configured source.
# 12  = last 12 months (default — first sync completes in ~15 min for typical amateur)
# 24  = last 2 years
# 0   = full history (slow — may take hours and span multiple days due to API rate limits)
# Increasing this value on a running deployment auto-triggers a re-backfill on the
# next restart so the extended window actually pulls older activities. Decreasing it
# leaves existing older data in the DB (this controls the backfill horizon, not retention).
VELOMATE_BACKFILL_MONTHS=12

# ── Display ─────────────────────────────────────────────────────────────────
# Display units for dashboards + CLI: metric (default) or imperial (USA: mi/ft/mph/°F).
# Storage stays metric; this only changes what's displayed. Selects the provisioned
# dashboard set at deploy time (no runtime switching). Use exactly metric or imperial —
# any other value resolves to a nonexistent dir and Grafana provisions no dashboards.
VELOMATE_UNITS=metric

# ── Advanced (rarely changed; compose defaults shown) ────────────────────────
# POSTGRES_VERSION=15                  # PostgreSQL image tag (default: 15)
# GRAFANA_VERSION=12.4.0               # Grafana image tag (default: 12.4.0)
# GF_AUTH_ANONYMOUS_ENABLED=false      # set true to allow anonymous Grafana viewing
# GF_SERVER_SERVE_FROM_SUB_PATH=false  # set true when serving Grafana under a sub-path
# PYTHONUNBUFFERED=1                   # ingestor log flushing — leave at 1
