          "color": {
            "mode": "fixed",
            "fixedColor": "dark-blue"
          },
          "unit": "lengthkm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-blue",
                "value": null
              }
            ]
          }
        }
      }
    },
