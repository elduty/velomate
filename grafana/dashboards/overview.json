    {
      "id": 403,
      "title": "6w Fitness \u0394",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND((a.ctl - b.ctl)::numeric, 1) AS \"6w CTL \u0394\"\nFROM (SELECT ctl FROM athlete_stats ORDER BY date DESC LIMIT 1) a,\n     (SELECT ctl FROM athlete_stats WHERE date <= CURRENT_DATE - 42 ORDER BY date DESC LIMIT 1) b;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      },
      "description": "Change in CTL (fitness) over the last 6 weeks.\n\nPositive = fitness improving.\nNegative = fitness declining."
