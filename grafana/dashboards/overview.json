    {
      "id": 6,
      "title": "TSS",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(COALESCE(SUM(tss), 0)::numeric, 0) AS \"TSS\" FROM activities WHERE $__timeFilter(date) AND (('${sport_type}' = 'all') OR sport_type = '${sport_type}');",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-purple",
                "value": null
              }
            ]
          }
        }
      },
      "description": "Training Stress Score\n\nHow much training load this period produced.\n\nCalculated from power (preferred) or heart rate.\n\n\u2022 < 150 \u2014 Easy week\n\n\u2022 150-300 \u2014 Moderate training\n\n\u2022 300-450 \u2014 Hard training\n\n\u2022 450+ \u2014 Very heavy load, watch recovery"
    },
    {
      "id": 200,
      "type": "row",
      "title": "Fitness",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 222,
      "title": "Form (TSB)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(tsb::numeric, 1) AS \"TSB\" FROM athlete_stats ORDER BY date DESC LIMIT 1;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -10
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "blue",
                "value": 15
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 15,
                "to": 999,
                "result": {
                  "text": "Fresh",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 15,
                "result": {
                  "text": "Optimal",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -10,
                "to": 0,
                "result": {
                  "text": "Tired",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -999,
                "to": -10,
                "result": {
                  "text": "Overreached",
                  "index": 3
                }
              }
            }
          ],
          "noValue": "No data"
        }
      },
      "description": "Training Stress Balance (Form)\nCTL minus ATL \u2014 are you fresh or fatigued?\n\n\ud83d\udd34 < -10 \u2014 Overreached, need rest\n\ud83d\udfe0 -10 to 0 \u2014 Tired, normal training fatigue\n\ud83d\udfe2 0 to 15 \u2014 Optimal, good balance\n\ud83d\udd35 > 15 \u2014 Fresh, race-ready (fitness may be declining)"
    },
    {
      "id": 223,
      "title": "Configured FTP",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT value::numeric AS \"FTP\"\nFROM sync_state\nWHERE key = 'configured_ftp' AND value::numeric > 0;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "fixedColor": "#8b5cf6",
            "mode": "fixed"
          },
          "noValue": "auto"
        }
      },
      "description": "FTP from VELOMATE_FTP environment variable. When unset, this card shows \"auto\" and the Est. FTP card to the right is what gets used for TSS computation."
    },
    {
      "id": 1020,
      "title": "Est. FTP",
      "type": "stat",
      "gridPos": {
        "x": 9,
        "y": 5,
        "w": 3,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT value::numeric AS \"FTP\"\nFROM sync_state\nWHERE key = 'estimated_ftp' AND value::numeric > 0;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "description": "Algorithmic FTP estimate from rolling 90-day best 20-min \u00d7 0.95. Shown for diagnostic comparison against the configured value. When this differs from Configured FTP by more than ~10%, consider doing an FTP test and updating VELOMATE_FTP."
    },
    {
      "id": 224,
      "title": "Weekly Streak",
      "description": "Weekly Riding Streak\n\nConsecutive weeks with at least one ride.\n\nCounts backward from your most recent\n\nriding week \u2014 doesn't break until a full\n\nweek passes without any cycling activity.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "WITH weeks AS (SELECT DISTINCT date_trunc('week', date)::date AS week_start FROM activities WHERE date IS NOT NULL AND sport_type IN ('cycling_outdoor', 'cycling_indoor', 'zwift', 'ebike')), latest AS (SELECT MAX(week_start) AS start_from FROM weeks), numbered AS (SELECT week_start, ROW_NUMBER() OVER (ORDER BY week_start DESC) AS rn, ((SELECT start_from FROM latest) - ((ROW_NUMBER() OVER (ORDER BY week_start DESC) - 1) * 7)::int) AS expected FROM weeks) SELECT COUNT(*) AS \"Weeks\" FROM numbered WHERE week_start = expected;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "fixedColor": "#6ed0ff",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 225,
      "title": "Days Since Ride",
      "description": "Days Since Last Ride\n\n\ud83d\udfe2 0-2 days \u2014 Active\n\n\ud83d\udfe1 3-4 days \u2014 Rest period\n\n\ud83d\udfe0 5-6 days \u2014 Extended break\n\n\ud83d\udd34 7+ days \u2014 Fitness declining",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT CURRENT_DATE - MAX(date::date) AS \"Days\" FROM activities WHERE sport_type IS NOT NULL AND (('${sport_type}' = 'all') OR sport_type = '${sport_type}');",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
