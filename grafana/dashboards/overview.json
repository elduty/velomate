    {
      "id": 402,
      "title": "Ride Types",
      "type": "piechart",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT\n  CASE sport_type\n    WHEN 'cycling_outdoor' THEN 'Outdoor'\n    WHEN 'zwift' THEN 'Zwift'\n    WHEN 'ebike' THEN 'E-Bike'\n    WHEN 'cycling_indoor' THEN 'Indoor'\n  END AS \"Type\",\n  COUNT(*) AS \"Rides\"\nFROM activities\nWHERE $__timeFilter(date)\n  AND (('${sport_type}' = 'all') OR sport_type = '${sport_type}')\n  AND sport_type IS NOT NULL\nGROUP BY 1;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^Rides$/"
        },
        "legend": {
          "displayMode": "list",
          "placement": "right",
