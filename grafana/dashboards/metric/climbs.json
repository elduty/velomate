  "templating": {
    "list": [
      {
        "name": "segment",
        "type": "query",
        "label": "Segment",
        "datasource": {
          "type": "postgres",
          "uid": "velomate"
        },
        "query": "SELECT s.id AS __value, COALESCE(s.name, s.auto_name) || ' (' || COUNT(e.id) || ' efforts)' AS __text FROM climb_segments s JOIN climb_efforts e ON e.segment_id = s.id GROUP BY s.id ORDER BY COUNT(DISTINCT e.activity_id) DESC, s.gain_m DESC",
        "refresh": 2,
        "sort": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 900,
      "type": "row",
      "title": "All Climb Segments",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 100,
      "type": "table",
      "title": "Climb Segments",
      "description": "Climbs you have ridden on at least two rides, found automatically from the detected climbs and then matched against the GPS track of every ride.\n\nRecord = fastest elapsed time from the start to the end point. Click a segment to open its leaderboard.\n\nRename a segment: `docker exec velomate-ingestor python3 segments.py rename <id> \"name\"` (`list` shows the ids).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "WITH stats AS (\n  SELECT e.segment_id,\n    COUNT(*) AS efforts,\n    COUNT(DISTINCT e.activity_id) AS rides,\n    MIN(e.elapsed_s) AS best,\n    MAX(a.date) AS last_ridden\n  FROM climb_efforts e\n  JOIN activities a ON a.id = e.activity_id\n  GROUP BY e.segment_id\n), best AS (\n  SELECT DISTINCT ON (e.segment_id) e.segment_id, a.date\n  FROM climb_efforts e\n  JOIN activities a ON a.id = e.activity_id\n  ORDER BY e.segment_id, e.elapsed_s, a.date\n)\nSELECT s.id AS \"ID\",\n  COALESCE(s.name, s.auto_name) AS \"Segment\",\n  s.category AS \"Category\",\n  s.length_m AS \"Length\",\n  s.gain_m AS \"Gain\",\n  s.avg_grade AS \"Avg Grade (%)\",\n  st.rides AS \"Rides\",\n  st.best AS \"Record\",\n  TO_CHAR(b.date, 'YYYY-MM-DD') AS \"Record Date\",\n  TO_CHAR(st.last_ridden, 'YYYY-MM-DD') AS \"Last Ridden\"\nFROM climb_segments s\nJOIN stats st ON st.segment_id = s.id\nLEFT JOIN best b ON b.segment_id = s.id\nORDER BY st.rides DESC, s.gain_m DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No climb segments yet \u2014 ride a climb twice",
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Segment"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open leaderboard",
                    "url": "/d/velomate-climbs/climbs?var-segment=${__data.fields.ID}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Segment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Length"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gain"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Record"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dthms"
              }
            ]
          }
        ]
      },
