    {
      "id": 107,
      "type": "table",
      "title": "Leaderboard",
      "description": "Every time you rode this segment, fastest first.\n\nElapsed = start to end including stops (used for the record). Moving = time spent above 2 km/h. VAM = vertical metres climbed per hour (m/h).\n\nHR and power columns fill in when the ride has those sensors.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 17,
        "h": 11
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT\n  RANK() OVER (ORDER BY e.elapsed_s) AS \"Rank\",\n  TO_CHAR(a.date, 'YYYY-MM-DD') AS \"Date\",\n  a.id AS \"_id\",\n  a.name AS \"Ride\",\n  e.elapsed_s AS \"Elapsed\",\n  e.moving_s AS \"Moving\",\n  e.elapsed_s - MIN(e.elapsed_s) OVER () AS \"Gap to Record\",\n  e.avg_speed_kmh AS \"Avg Speed\",\n  e.vam_mh AS \"VAM\",\n  e.avg_hr AS \"Avg HR\",\n  e.avg_power AS \"Avg Power\"\nFROM climb_efforts e\nJOIN activities a ON a.id = e.activity_id\nWHERE e.segment_id = NULLIF('${segment}', '')::integer\nORDER BY e.elapsed_s, a.date;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No efforts",
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
