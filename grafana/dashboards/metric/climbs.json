    {
      "id": 108,
      "type": "geomap",
      "title": "Record Effort",
      "description": "The segment as ridden on your record effort, coloured by altitude (green low, red high).",
      "gridPos": {
        "x": 17,
        "y": 14,
        "w": 7,
        "h": 11
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "WITH best AS (\n  SELECT activity_id, start_offset, end_offset\n  FROM climb_efforts\n  WHERE segment_id = NULLIF('${segment}', '')::integer\n  ORDER BY elapsed_s\n  LIMIT 1\n)\nSELECT s.lat AS \"latitude\", s.lng AS \"longitude\", s.altitude_m AS \"metric\", s.time_offset\nFROM activity_streams s\nJOIN best b ON b.activity_id = s.activity_id\nWHERE s.time_offset BETWEEN b.start_offset AND b.end_offset\n  AND s.lat IS NOT NULL AND s.lng IS NOT NULL\nORDER BY s.time_offset;",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 16
        },
        "layers": [
          {
            "type": "route",
            "name": "Segment",
            "config": {
              "style": {
                "color": {
                  "field": "metric",
                  "fixed": "green"
                },
                "opacity": 0.9,
                "lineWidth": 4
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "Time on Segment",
      "description": "Elapsed and moving time of every effort. Record at the Time steps down each time you set a new record.\n\nUses the dashboard time range.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 17,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT a.date + e.start_offset * interval '1 second' AS time,\n  e.elapsed_s AS \"Elapsed\",\n  e.moving_s AS \"Moving\",\n  MIN(e.elapsed_s) OVER (ORDER BY a.date, e.start_offset) AS \"Record at the Time\"\nFROM climb_efforts e\nJOIN activities a ON a.id = e.activity_id\nWHERE e.segment_id = NULLIF('${segment}', '')::integer\n  AND $__timeFilter(a.date)\nORDER BY a.date, e.start_offset;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dthms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 7,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Record at the Time"
            },
            "properties": [
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 110,
      "type": "timeseries",
      "title": "Climbing Pace",
      "description": "Average speed and VAM (vertical metres per hour, m/h) of every effort. Higher is better for both.\n\nUses the dashboard time range.",
      "gridPos": {
        "x": 17,
        "y": 25,
        "w": 7,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "velomate"
      },
      "targets": [
        {
          "rawSql": "SELECT a.date + e.start_offset * interval '1 second' AS time,\n  e.avg_speed_kmh AS \"Avg Speed\",\n  e.vam_mh AS \"VAM\"\nFROM climb_efforts e\nJOIN activities a ON a.id = e.activity_id\nWHERE e.segment_id = NULLIF('${segment}', '')::integer\n  AND $__timeFilter(a.date)\nORDER BY a.date, e.start_offset;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 7,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": [
          {
